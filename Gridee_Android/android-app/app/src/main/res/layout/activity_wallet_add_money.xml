<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:focusable="true" android:focusableInTouchMode="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingVertical="10dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_back" style="@style/Widget.Gridee.BackButton.IOS26"
            android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="@string/back"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center" android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back" app:tint="@color/brand_primary" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/tv_header_title"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp" android:paddingStart="0dp" android:paddingEnd="48dp"
            android:gravity="center" android:fontFamily="@font/inter_medium"
            android:text="@string/add_money" android:textColor="@color/brand_primary" android:textSize="17sp"
            app:layout_constraintStart_toEndOf="@id/btn_back" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true" android:clipChildren="false" android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/layout_action_footer"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/amount_stage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical"
            android:clipChildren="false" android:clipToPadding="false"
            android:paddingHorizontal="24dp" android:paddingTop="20dp" android:paddingBottom="52dp">
            <TextView android:id="@+id/tv_current_balance"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:fontFamily="@font/inter_medium"
                android:textColor="@color/wallet_supporting_text" android:textSize="13sp"
                android:fontFeatureSettings="tnum" />

            <LinearLayout android:id="@+id/ll_amount_container"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:gravity="center_vertical"
                android:orientation="horizontal" android:layoutDirection="ltr"
                android:clipChildren="false" android:clipToPadding="false">
                <ImageView android:id="@+id/iv_amount_coin"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_marginEnd="10dp" android:importantForAccessibility="no"
                    android:src="@drawable/ic_wallet_coin_outline" />
                <com.gridee.parking.ui.wallet.WalletAmountEditText
                    android:id="@+id/et_amount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="40dp" android:minHeight="64dp"
                    android:background="@null" android:paddingHorizontal="3dp" android:paddingVertical="6dp"
                    android:includeFontPadding="false" android:gravity="center_vertical|start"
                    android:fontFamily="@font/inter_semibold" android:fontFeatureSettings="tnum"
                    android:hint="@string/wallet_amount_zero" android:inputType="number" android:imeOptions="actionDone"
                    android:singleLine="true" android:textDirection="ltr"
                    android:textColor="@color/brand_primary" android:textColorHint="@color/wallet_amount_hint"
                    android:textCursorDrawable="@drawable/bg_wallet_amount_cursor" android:textSize="54sp" />
            </LinearLayout>

            <TextView android:id="@+id/tv_minimum_amount"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center"
                android:fontFamily="@font/inter_medium" android:textSize="13sp"
                android:textColor="@color/wallet_supporting_text"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:id="@+id/layout_action_footer"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/background_primary"
        android:paddingHorizontal="24dp" android:paddingTop="14dp" android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:id="@+id/button_container"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_money_confirm"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:paddingVertical="14dp" android:paddingHorizontal="24dp"
                android:enabled="false" android:fontFamily="@font/inter_semibold"
                android:insetTop="0dp" android:insetBottom="0dp" android:stateListAnimator="@null"
                android:text="@string/add_money" android:textAllCaps="false"
                android:textColor="@color/wallet_button_disabled_text" android:textSize="16sp"
                app:backgroundTint="@color/wallet_button_disabled" app:cornerRadius="28dp" app:elevation="0dp" />
            <LinearLayout android:id="@+id/loading_content"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:paddingHorizontal="20dp" android:orientation="horizontal"
                android:importantForAccessibility="noHideDescendants" android:visibility="gone">
                <ProgressBar android:id="@+id/pb_loading"
                    android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/md3_on_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/wallet_opening_checkout" android:fontFamily="@font/inter_semibold"
                    android:gravity="center" android:textSize="16sp" android:textColor="@color/md3_on_primary" />
            </LinearLayout>
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="14dp"
            app:drawableStartCompat="@drawable/ic_wallet_lock_outline" android:drawablePadding="6dp"
            android:gravity="center" android:fontFamily="@font/inter_medium"
            android:text="@string/wallet_cashfree_reassurance"
            android:textColor="@color/wallet_supporting_text" android:textSize="12sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
