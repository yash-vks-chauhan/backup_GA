<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--
      "Depth window": the creative is cut INTO the page rather than laid on a card over it.

      There is no card chrome, no fill and no button — the unit is 100% media, so every pixel
      of footprint is picture. That is the whole point: it delivers the same creative area as a
      full-width media card (66,946 px² at this width) while taking 20.3% of the screen instead
      of 34%, because a media card spends ~40% of itself on icon row, padding and a button.

      The frame is a true 1.91:1. That ratio is not cosmetic — because the unit IS the creative,
      its shape is the creative's shape, and any height past 1.91:1 buys letterbox bars rather
      than picture. An earlier 358x210 draft wasted 8,234 px² on exactly that.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ad_window"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="#0E1113"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="H,1.91:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:strokeColor="@color/nav_floating_stroke"
            app:strokeWidth="0.5dp">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/admob_media_content"
                tools:background="@color/border_light" />

            <!--
              Recess, not elevation. A drop shadow would push the unit forward and put it in
              competition with the spot cards floating above; a shallow inset along the top edge
              reads as a cut in the surface instead. Kept to 8dp and low alpha deliberately —
              an overlay across an ad is only defensible while it is this slight.
            -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_ad_window_recess" />

            <!-- Functional scrim: the headline and advertiser sit on the creative, and this is
                 what keeps them legible over a bright one. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_ad_media_scrim" />

            <!-- Top-left, opposite the SDK's AdChoices overlay (ADCHOICES_TOP_RIGHT) so the two
                 never collide. With no frame around the unit, this label and AdChoices are the
                 only things separating ad from app — they do not get to be subtle.

                 Absolute "left" rather than "start": supportsRtl is true app-wide, so "start"
                 mirrors to the right under an RTL locale and lands directly on AdChoices, which
                 stays pinned TOP_RIGHT and does not mirror. Obscuring it is a policy violation,
                 so this one gravity stays absolute even though the rest of the card is not. -->
            <TextView
                android:id="@+id/ad_attribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:layout_margin="10dp"
                android:background="@drawable/bg_custom_ad_label"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="@string/custom_ad_label"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                tools:ignore="RtlHardcoded" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- ShapeableImageView, not ImageView + clipToOutline: that attribute
                             only takes effect on API 31+, and minSdk here is 24 — on everything
                             older the icon would sit as a hard square on a rounded matte. -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ad_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_admob_native_icon_small"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            app:shapeAppearance="@style/ShapeAppearance.Gridee.AdIcon"
                            tools:src="@color/border_light" />

                        <TextView
                            android:id="@+id/ad_advertiser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.01"
                            android:maxLines="1"
                            android:shadowColor="#8C000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="5"
                            android:textColor="#B8FFFFFF"
                            android:textSize="11sp"
                            tools:text="Larsen Auto Care" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:maxLines="2"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        tools:text="Free 20-point car check this week" />

                    <!--
                      Star rating and price. These are the app-install assets: a native unit
                      with nowhere to put them either loses those creatives or serves them
                      degraded, and app installs are a large share of mobile native demand.
                      Both are optional in the response, so the whole row collapses when
                      neither is present — which is the common case for brand creatives.

                      Stars are white, not gold. Gold is Gridee's accent and spending it on a
                      third-party creative blurs the line between our UI and an advertiser's,
                      the same reason the call to action is glass rather than gold.
                    -->
                    <LinearLayout
                        android:id="@+id/ad_meta_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <RatingBar
                            android:id="@+id/ad_stars"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressBackgroundTint="#59FFFFFF"
                            android:progressTint="#FFFFFFFF"
                            android:secondaryProgressTint="#4DFFFFFF"
                            android:stepSize="0.1"
                            tools:rating="4.6" />

                        <TextView
                            android:id="@+id/ad_rating_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:shadowColor="#8C000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="5"
                            android:textColor="#B8FFFFFF"
                            android:textSize="11sp"
                            tools:text="4.6" />

                        <View
                            android:id="@+id/ad_meta_dot"
                            android:layout_width="3dp"
                            android:layout_height="3dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="@drawable/bg_ad_meta_dot" />

                        <TextView
                            android:id="@+id/ad_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="#8C000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="5"
                            android:textColor="#B8FFFFFF"
                            android:textSize="11sp"
                            tools:text="Free" />

                    </LinearLayout>

                </LinearLayout>

                <!--
                  Solid white pill, the same filled material as the partner referral button.
                  Glass took its brightness from the creative behind it, so the action faded
                  out on any pale image; a flat white body reads identically on every one.
                  It carries the real callToAction text — registering the asset and then
                  showing only an arrow would be withholding an asset we claimed.

                  44dp tall, which is the floor. The old card's 28dp was under every one.
                -->
                <LinearLayout
                    android:id="@+id/ad_call_to_action"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_ad_white_pill"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/ad_call_to_action_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="120dp"
                        android:textColor="#0E1113"
                        android:textSize="13sp"
                        tools:text="Book now" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right_ad"
                        app:tint="#0E1113" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
