<?xml version="1.0" encoding="utf-8"?>
<!--
  One campaign in the deck.

  The root must be match_parent in BOTH axes — ViewPager2 rejects a wrap_content page with
  "Pages must fill the whole ViewPager2". The card inside is the 124 dp one, pinned to the
  top of the taller page so the stacked cards behind it have somewhere to peek out.

  Landscape, because that is the shape the creatives are actually authored in — the
  previous 2:3 portrait rail centre-cropped a wide banner and mangled it. Creative-only:
  the artwork is the ad, and everything it cannot say at this size lives in the spotlight
  a tap opens.

  The height below is only the first-frame value. EventDeckAdapter sets the real one, a 16:9
  frame measured off the page width, because a fixed dp height is a different aspect on every
  phone — 124 dp came out at 3:1 on a 411 dp-wide screen and centre-cropped the artwork down
  to a strip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="2dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_event_deck"
        android:layout_width="match_parent"
        android:layout_height="208dp"
        android:layout_gravity="top"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/skeleton_base"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_event_deck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/event_poster_content_description"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_code_shield" />

        <!--
          The disclosure rides on the creative now, not on a heading above the rail. The rail
          mixes our own paid campaigns with an AdMob card, so a single chip over both would be
          the only label on either and would sit too far from each to mean anything. Same chip,
          same corner, on every page — so which page is up never changes what the label says.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_custom_ad_label"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2.5dp"
            android:text="@string/custom_ad_label"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
