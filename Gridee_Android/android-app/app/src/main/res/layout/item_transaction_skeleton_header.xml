<?xml version="1.0" encoding="utf-8"?>
<!-- One skeleton date header (echoes "Today"/"Yesterday"). Inflated by
     SkeletonShimmer.populate every few rows. Width is set per header in code. -->
<View xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeleton_header"
    android:layout_width="72dp"
    android:layout_height="14dp"
    android:layout_marginStart="4dp"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="10dp"
    android:alpha="0.55"
    android:background="@drawable/bg_skeleton_pill"
    android:tag="skeleton_pill" />
