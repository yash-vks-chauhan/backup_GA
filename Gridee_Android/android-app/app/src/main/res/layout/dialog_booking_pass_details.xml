<?xml version="1.0" encoding="utf-8"?>
<!--
  Where the booking ID went.

  The ID used to sit in the most valuable line on the pass, directly under the code,
  where it told the user nothing they could act on. It is still needed — support asks
  for it — so it lives here, one tap away, with a Copy action that actually helps.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/details_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000" />

    <androidx.cardview.widget.CardView
        android:id="@+id/details_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardBackgroundColor="@color/background_secondary"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:letterSpacing="-0.025"
                android:text="@string/booking_pass_details"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tv_details_spot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="2"
                android:textColor="@color/text_tertiary"
                android:textSize="12.5sp"
                tools:text="Level 1 · A-12 · SRM Main Parking" />

            <!-- The ID row: monospaced so an operator can read it back over a phone. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.12"
                        android:text="@string/booking_details_sheet_id"
                        android:textAllCaps="true"
                        android:textColor="@color/text_tertiary"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tv_details_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="68b3f2a91c4d7e0042ab19c7" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_details_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_ad_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/booking_details_sheet_copy"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/nav_floating_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.12"
                        android:text="@string/started"
                        android:textAllCaps="true"
                        android:textColor="@color/text_tertiary"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tv_details_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        tools:text="08:51 PM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.12"
                        android:text="@string/ends"
                        android:textAllCaps="true"
                        android:textColor="@color/text_tertiary"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tv_details_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        tools:text="10:51 PM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.12"
                        android:text="@string/amount"
                        android:textAllCaps="true"
                        android:textColor="@color/text_tertiary"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tv_details_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        tools:text="₹80.00" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_details_done"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_brand_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/done"
                android:textColor="@color/btn_text_on_brand"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
