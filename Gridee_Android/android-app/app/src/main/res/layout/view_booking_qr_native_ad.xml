<?xml version="1.0" encoding="utf-8"?>
<!--
  The AdMob native card on the booking pass.

  Not a card any more: no radius, no elevation, no stroke, no surface behind it. It fills the
  bottom band of the pass edge to edge, which is the whole point of the layout — the ad zone
  has no frame of its own, so it cannot look like an empty frame when the creative is slow.
  The media IS the surface.

  SIZED AND TYPED TO THE MONETIZATION AUDIT'S P1 REQUIREMENTS, which the rail version of this
  layout failed on three counts:

    - Supporting text is 14 sp, not the 11.5 sp it used when three of these shared a
      swipeable deck. The audit's floor for readable supporting copy is 14–16 sp.
    - The "Ad" label is 12 sp, not 9 sp. Native policy requires the attribution to be
      clearly legible, and 9 sp was called out by name.
    - The call to action is 48 dp, not 34/40 dp — the accessibility touch-target minimum,
      and a real engagement lever on a band this size.

  Every optional asset the SDK can return has a slot here: icon, body, star rating, price and
  store, on top of headline/advertiser/CTA/media. Several demand sources weight asset
  completeness when bidding and some creatives will not serve at all without an icon or body,
  so an incomplete slot set is a demand-eligibility gap rather than a cosmetic one. Each slot
  is registered ONLY when its asset is actually present — a registered-but-empty view is a
  native-policy problem in its own right.

  Text sits over a bottom scrim on the creative rather than on a panel below it.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/skeleton_base">

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/admob_media_content"
            tools:background="@color/skeleton_base" />

        <!-- Tall enough to cover the whole copy block at its fullest — icon row, two-line
             headline, two-line body, rating row and a 48 dp action. A short scrim left the
             first line sitting on bare image pixels. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_ad_media_scrim" />

        <!-- Opposite the SDK-rendered AdChoices asset, which is placed top-right and must
             stay unobstructed. Nothing of ours is drawn in that corner. -->
        <TextView
            android:id="@+id/ad_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:background="@drawable/bg_custom_ad_label"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3.5dp"
            android:text="@string/custom_ad_label"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!--
          Bottom padding is topped up in code with the gesture inset: the creative bleeds to
          the very bottom edge of the screen, so only the type has to clear the nav bar.
        -->
        <LinearLayout
            android:id="@+id/ad_text_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <LinearLayout
                android:id="@+id/ad_brand_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ad_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="11dp"
                    android:background="@drawable/bg_admob_native_icon_small"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearance="@style/ShapeAppearance.Gridee.AdIcon"
                    tools:src="@color/border_light"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/ad_advertiser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.86"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    tools:text="Meridian Insurance" />
            </LinearLayout>

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:letterSpacing="-0.03"
                android:maxLines="2"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Cover your car in under two minutes" />

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:alpha="0.84"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:maxLines="2"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Comprehensive cover, instant quote, no paperwork."
                tools:visibility="visible" />

            <!-- Star rating, price and store arrive only on app-install creatives. The whole
                 row collapses when none of them is returned. -->
            <LinearLayout
                android:id="@+id/ad_meta_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <RatingBar
                    android:id="@+id/ad_stars"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#FFFFFFFF"
                    android:secondaryProgressTint="#4DFFFFFF"
                    android:stepSize="0.1"
                    tools:rating="4.6" />

                <TextView
                    android:id="@+id/ad_rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:textColor="#F2FFFFFF"
                    android:textSize="14sp"
                    tools:text="4.6" />

                <View
                    android:id="@+id/ad_meta_dot"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_ad_meta_dot"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/ad_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#D6FFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Free"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/ad_store"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#B8FFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Google Play"
                    tools:visibility="visible" />
            </LinearLayout>

            <!--
              48 dp: the accessibility touch-target minimum, which the audit flags as a
              violation at 28 dp on Home and which this placement has the room to honour
              comfortably. A full pill at 24 dp — half the height — rather than a rounded
              rectangle.

              Fixed white on near-black, NOT the theme tokens. This button never sits on a page
              surface — it always sits on the creative's own dark scrim — so tinting it
              background_secondary meant that in dark mode a #1C1C1E button landed on a
              #D9000000 scrim and the shape vanished, leaving a floating label.

              Neutral white rather than the app's brand accent on purpose: spending the
              product's own accent on a third-party creative blurs the line between our UI and
              an advertiser's, which is bad for trust and against native ad policy.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ad_call_to_action"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/inter_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingHorizontal="22dp"
                android:textAllCaps="false"
                android:textColor="#0B0B0C"
                android:textSize="14sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="24dp"
                app:elevation="0dp"
                tools:text="Get a quote" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
