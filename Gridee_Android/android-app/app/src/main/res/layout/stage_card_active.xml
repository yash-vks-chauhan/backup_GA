<?xml version="1.0" encoding="utf-8"?>
<!--
  The Checked-in stop, expanded.

  Same anatomy as stage_card_pending — head, body, tear line, stub — with two differences
  that are deliberate rather than incidental:

    1. The progress bar IS the check-in → check-out rail, so its endpoints are labelled
       underneath instead of repeating the rail-and-capsule row from the Booked card.
    2. The stub carries no cancel. The backend refuses cancellation once an operator has
       checked the car in, so the control is absent rather than present-and-disabled.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.gridee.parking.ui.views.StageRailView
        android:id="@+id/stage_rail"
        android:layout_width="20dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.gridee.parking.ui.views.TicketView
        android:id="@+id/card_stage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginBottom="15dp"
        app:cardBackgroundColor="@color/background_secondary"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toEndOf="@id/stage_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_stage_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stage_card_head_active"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view_stage_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot_inactive"
                        android:backgroundTint="@color/status_text_active" />

                    <TextView
                        android:id="@+id/text_stage_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:text="@string/stage_live_caps"
                        android:textColor="@color/status_text_active"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/text_stage_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/stage_head_active_sub"
                        android:textSize="13sp"
                        tools:text="FRI, 03 APR" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_spot_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_bold"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:singleLine="true"
                    android:textColor="@color/stage_head_active_ink"
                    android:textSize="18sp"
                    tools:text="Java — Morning" />

                <TextView
                    android:id="@+id/text_lot_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:singleLine="true"
                    android:textColor="@color/stage_head_active_sub"
                    android:textSize="13sp"
                    tools:text="SRM University Parking Lot" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_remaining_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_time_remaining"
                            android:textColor="@color/text_tertiary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/text_time_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_bold"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.045"
                            android:textColor="@color/status_text_active"
                            android:textSize="32sp"
                            tools:text="1h 20m" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_time_until"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="until 12:30 PM" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/layout_progress_track"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_active_progress_track" />

                    <View
                        android:id="@+id/view_progress_fill"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_active_progress_fill_green" />

                    <View
                        android:id="@+id/view_now_marker"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shape_now_marker_core" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_check_in"
                            android:textColor="@color/text_tertiary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/text_check_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/inter_bold"
                            android:textStyle="bold"
                            android:letterSpacing="-0.025"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            tools:text="07:30 AM" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_check_out"
                            android:textColor="@color/text_tertiary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/text_check_out"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/inter_bold"
                            android:textStyle="bold"
                            android:letterSpacing="-0.025"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            tools:text="12:30 PM" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="15dp"
                    android:background="@color/divider_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="15dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_vehicle"
                            android:textColor="@color/text_tertiary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/text_vehicle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_bold"
                            android:textStyle="bold"
                            android:letterSpacing="0.01"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            tools:text="TN 09 AB 1234" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_paid"
                            android:textColor="@color/text_tertiary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- The Gridee coin, not a currency symbol: balances are held in
                                 coins, and item_booking_active_pass already marks amounts this
                                 way. bg_gridee_coin_dark is the only variant that themes —
                                 _wire and _ghost hardcode #FFFFFF for the wallet's gradient. -->
                            <TextView
                                android:id="@+id/coin_amount"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_gridee_coin_dark"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingTop="1dp"
                                android:text="@string/gridee_coin_glyph"
                                android:textColor="@color/btn_text_on_brand"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:textStyle="bold"
                                android:letterSpacing="-0.02"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                tools:text="90.00" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- The tear line, and the anchor TicketView measures its notches from: it
                 finds this child by id and punches a 16dp bite out of each edge at its
                 vertical centre, so the card reads as a real perforated ticket.

                 2dp, not 1dp: a shape-line is stroked about the view's vertical centre, so a
                 1dp stroke in a 1dp box loses half its width off each edge and renders as
                 nothing. item_booking_active_pass hit the same thing and settled on 2dp. -->
            <FrameLayout
                android:id="@+id/layout_cutout"
                android:layout_width="match_parent"
                android:layout_height="2dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/bg_perforated_divider_subtle"
                    android:layerType="software" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_pass_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/pass_stub_surface"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="15dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/text_pass_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/pass_show_at_exit"
                    android:textColor="@color/pass_stub_label"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/image_pass_code"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/pass_show_at_exit" />

                <TextView
                    android:id="@+id/badge_tap_to_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_pass_badge"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.005"
                    android:paddingHorizontal="11dp"
                    android:text="@string/pass_tap_to_scan"
                    android:textColor="@color/pass_badge_ink"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.gridee.parking.ui.views.TicketView>

</androidx.constraintlayout.widget.ConstraintLayout>
