<?xml version="1.0" encoding="utf-8"?>
<!--
  Booking pass.

  Three bands, top to bottom: the header, the code, and one full-bleed creative.

  The page has exactly ONE horizontal edge on it, and that edge belongs to the ad. The top
  of the screen simply *is* the booking's state — the same amber/green wash the stage cards
  wear on the bookings tab — dissolving into the page colour well above the fold, so there
  is no seam to align and no panel to draw. Below the code the creative runs to all four
  edges: the ad zone cannot read as empty because it has no empty state, the surface *is*
  the creative.

  There is no card, no plate and no rail here any more. What used to be a swipeable deck of
  campaigns with the AdMob card as page 0 is now the AdMob native card and nothing else.

  Nothing scrolls. The code takes what the header and the creative leave it, down to
  PLATE_MIN_DP, at which point it is still ~33 mm across and comfortably scannable.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/qr_pass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!--
      The state wash. Height and gradient are both set in code, because the colour depends on
      whether the booking is Booked or Live and the fade has to land a fixed distance above
      the creative's top edge rather than at a fixed dp from the top.

      Landing the fade exactly ON that edge is the one way this composition fails — any
      rounding leaves a faint coloured band above the image — so applyWashGradient stops it
      WASH_CLEARANCE_DP short and lets the page colour hold the gap.
    -->
    <View
        android:id="@+id/qr_pass_wash"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ───────── header ─────────
             The app's 44 dp IOS26 back disc at the start, and the SPOT NAME centred where the
             screen title used to be. "Booking Pass" said nothing the rest of the screen was
             not already saying, and the spot is the one thing an operator asks for.

             Type matches the bookings tab's own card head — 18 sp inter_bold with textStyle
             bold and -0.02 tracking, the same run as text_spot_name in stage_card_active. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/qr_pass_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_close_qr_pass"
                style="@style/Widget.Gridee.BackButton.IOS26"
                android:layout_width="@dimen/ios26_back_button_size"
                android:layout_height="@dimen/ios26_back_button_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/ios26_back_icon_size"
                    android:layout_height="@dimen/ios26_back_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/brand_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_qr_pass_lot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="wrap"
                android:layout_marginStart="52dp"
                android:layout_marginEnd="52dp"
                tools:text="Java — Morning" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ───────── the code ─────────
             Takes everything the header and the creative leave, and centres the code in it.
             applyPlateSize measures this block rather than assuming a height. -->
        <LinearLayout
            android:id="@+id/qr_pass_block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <!--
              Unplated in light mode. The wash and the page colour behind it are both within a
              hair of white (#ECFDF5 / #FFFBEB over #F5F5F5), so they give a scanner its own
              quiet zone and the code needs no surface of its own.

              In dark mode bg_qr_quiet_zone is white and the code keeps a ground, because the
              modules are BLACK in both themes and stay that way. Inverting them to light-on-
              dark is a real risk on barrier hardware — plenty of fixed scanners only decode
              dark-on-light — and this is the one screen in the app whose whole job is to be
              scanned. Padding is identical in both themes so the code is the same size either
              way; the generator bakes in a 2-module quiet zone on top of it.
            -->
            <ImageView
                android:id="@+id/iv_qr_pass_code"
                android:layout_width="268dp"
                android:layout_height="268dp"
                android:background="@drawable/bg_qr_quiet_zone"
                android:contentDescription="@string/booking_qr_code"
                android:padding="16dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_code_shield" />

            <TextView
                android:id="@+id/tv_qr_pass_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:letterSpacing="-0.015"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="Hold up to the exit scanner" />

        </LinearLayout>

        <!-- ───────── the creative ─────────
             One AdMob native card, bled to all four edges. Its height is set in code as a
             fraction of the screen so the split holds on every device rather than only on the
             one it was drawn for.

             Order matters: the ad is first so the skeleton draws over it. The ad view is GONE
             until it has a creative, so the SDK cannot log an impression for a card behind the
             skeleton.

             There is no house fallback here and no other paid surface: this band is the AdMob
             native placement or it is nothing. When the request comes back empty the band
             collapses to zero and the code takes the whole page — an ad zone with no ad in it
             is not a zone. -->
        <FrameLayout
            android:id="@+id/qr_pass_tray"
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <com.gridee.parking.ui.ads.BookingQrNativeAdView
                android:id="@+id/native_ad"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Reserves the whole zone from the first frame so nothing jumps on reveal. -->
            <View
                android:id="@+id/tray_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/skeleton_base"
                android:tag="skeleton_pill"
                tools:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
