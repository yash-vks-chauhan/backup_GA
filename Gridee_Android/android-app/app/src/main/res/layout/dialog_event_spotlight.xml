<?xml version="1.0" encoding="utf-8"?>
<!--
  Event spotlight.

  A poster has no button because it doesn't need one — the whole thing is the
  target. Tapping lifts it out of the rail into the middle of the screen over a
  blurred backdrop, at roughly 2.4× its rail size, carrying the detail the
  poster couldn't hold at 96 dp: full title, meta line, and one primary action.

  The window itself supplies the blur (FLAG_BLUR_BEHIND) — the same API the
  booking QR dialog already uses — so this layout only draws the content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/spotlight_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tap-anywhere-outside to dismiss. -->
    <View
        android:id="@+id/spotlight_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000" />

    <LinearLayout
        android:id="@+id/spotlight_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/btn_spotlight_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_spotlight_close"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_spotlight_poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/skeleton_base"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_spotlight_poster"
                android:layout_width="match_parent"
                android:layout_height="345dp"
                android:contentDescription="@string/event_poster_content_description"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_code_shield" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_spotlight_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_bold"
            android:letterSpacing="-0.028"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            tools:text="Anuv Jain · Live in concert" />

        <TextView
            android:id="@+id/tv_spotlight_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="2"
            android:textColor="#ADFFFFFF"
            android:textSize="12.5sp"
            tools:text="Sat 24 Aug, 7 pm · Phoenix Grounds · 400 m away" />

        <TextView
            android:id="@+id/btn_spotlight_cta"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_spotlight_cta"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:textColor="#111214"
            android:textSize="14sp"
            tools:text="Get tickets" />

        <TextView
            android:id="@+id/tv_spotlight_attribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="#73FFFFFF"
            android:textSize="10sp"
            tools:text="Ad · Phoenix Live" />
    </LinearLayout>
</FrameLayout>
