<?xml version="1.0" encoding="utf-8"?>
<!--
  Bookings tab.

  NO HEADER, and nothing scrolls.

  The title is gone on purpose. The bottom nav already says "Bookings", and the card's own head
  says BOOKED / Java / SRM University Parking — a centred word in a 97 dp band above all that was
  a third label for the same thing. It was also the wrong shape: a title centred with nothing
  either side is the pattern you get when a back button has been removed, and it sat over a
  left-anchored rail, so centred chrome floated over asymmetric content.

  Pull-to-refresh is gone too. The screen polls its own booking every couple of seconds now
  (see BookingsFragmentNew.transitionWatchRunnable), so a manual pull refreshed nothing that was
  not about to refresh anyway — and SwipeRefreshLayout's drag, plus Android 12's stretch
  overscroll, were what made a page that fits on one screen feel loose.

  What is left is one fixed page: the rail, centred between the status bar and the floating nav
  capsule.

  Centring is a ConstraintLayout bias on a wrap_content list, NOT FrameLayout layout_gravity.
  Gravity did not survive here: BaseActivityWithBottomNav.applyFloatingNavBottomPadding reaches
  in and rewrites this view's bottom padding after inflation, and a RecyclerView re-measures its
  wrap_content height on every data change, so the two together left the list pinned at y=0.
  A bias re-solves on each pass instead of being applied once at placement.

  Nothing here reserves room for the capsule either. That same helper already adds 68dp plus the
  gesture inset to this list's bottom padding, so the margin that used to be here was reserving
  it a second time — which is where the ~180dp hole under the rail came from.

  It still degrades correctly if remote config ever turns multipleBookings on: a wrap_content
  RecyclerView clamps to the space available and scrolls inside it.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fitsSystemWindows="false">

    <!-- The status-bar inset lands on this fragment's root, applied by the fragment itself
         rather than waiting on MainContainerActivity's insets dispatch — a fragment created
         after the last dispatch never got it, which is why the card was being sliced by the
         status bar. Bottom padding is the capsule helper's job, not this file's. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bookings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        tools:listitem="@layout/item_booking_rail" />

    <!-- Sits exactly where the list will, on the same bias, so the card does not move when it
         arrives. Its own visibility is driven by BookingsFragmentNew.showSkeleton. -->
    <include
        android:id="@+id/layout_skeleton"
        layout="@layout/view_bookings_skeleton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_empty_state"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/content_desc_no_bookings"
            android:src="@drawable/ic_bookings_filled"
            app:tint="@color/segment_track_color" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/inter_bold"
            android:letterSpacing="-0.01"
            android:text="@string/no_active_bookings"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_empty_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:maxWidth="320dp"
            android:text="@string/empty_bookings_body"
            android:textAlignment="center"
            android:textColor="@color/text_tertiary"
            android:textSize="17sp" />

        <!-- The tab empties the moment a booking ends — cancelled, checked out or missed, it
             moves to Booking History. Without this the screen is a dead end, and booking again
             means knowing to go back to Home on your own. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_find_parking"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/inter_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="52dp"
            android:paddingHorizontal="28dp"
            android:text="@string/empty_bookings_cta"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_on_brand"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="26dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
