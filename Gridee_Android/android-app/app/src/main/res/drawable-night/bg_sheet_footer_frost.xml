<?xml version="1.0" encoding="utf-8"?>
<!-- Night mirror of bg_sheet_footer_frost — sheet surface is #1C1C1E. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Full-height dissolve — long gentle tail upward -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#1C1C1E"
                android:centerColor="#CC1C1C1E"
                android:endColor="#001C1C1E"
                android:centerY="0.58"
                android:type="linear" />
        </shape>
    </item>
    <!-- Layer 2: Mid-band reinforcement -->
    <item android:top="40dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#D91C1C1E"
                android:centerColor="#801C1C1E"
                android:endColor="#001C1C1E"
                android:centerY="0.45"
                android:type="linear" />
        </shape>
    </item>
    <!-- Layer 3: Bottom anchor — opaque through the band the pill sits in -->
    <item android:top="68dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#1C1C1E"
                android:endColor="#001C1C1E"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
