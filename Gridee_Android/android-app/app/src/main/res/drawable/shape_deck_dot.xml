<?xml version="1.0" encoding="utf-8"?>
<!--
  One page marker under the ad rail. A rectangle rather than an oval so the active
  marker can stretch into a pill without swapping drawables — same shape, wider.
  Tinted in code: active is text_primary, the rest text_tertiary at low alpha.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="3dp" />
</shape>
