<?xml version="1.0" encoding="utf-8"?>
<!-- The dissolve directly below the chat header's solid block.

     The header scrim is deliberately split in two: a solid slab sized to the header
     (so the title is always fully legible, whatever the status bar height or font
     scale) plus this short fade, so bubbles dissolve as they pass under instead of
     hitting a hard edge. A single stretched multi-stop gradient can't do both — its
     opaque band drifts as the header height changes, which is what let messages show
     through behind the title. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/background_primary"
        android:endColor="@color/background_primary_transparent"
        android:type="linear" />
</shape>
