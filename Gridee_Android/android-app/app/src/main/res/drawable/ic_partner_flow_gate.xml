<?xml version="1.0" encoding="utf-8"?>
<!--
  Beat 3: the boom barrier lifts. Drawn already raised — the whole promise of the
  step is that the driver never sees it down. Set matches the other three flow
  glyphs: 24dp, 1.6 stroke, round caps.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Post and its footing. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M5 20.5 V9.1 M2.8 20.5 h4.4"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />

    <!-- Pivot. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M3.9 8 a1.1 1.1 0 1 0 2.2 0 a1.1 1.1 0 1 0 -2.2 0"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6" />

    <!-- Arm, raised. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M6.6 7.4 L20.5 4"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />

    <!-- Two hazard stripes, struck perpendicular to the arm. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M10.7 5.4 L11.2 7.3 M15 4.4 L15.5 6.3"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />

</vector>
