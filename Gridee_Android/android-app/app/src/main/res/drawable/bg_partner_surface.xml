<?xml version="1.0" encoding="utf-8"?>
<!--
  The one card shape the pitch uses — pitch card, value list, payout ladder,
  timeline, share block. Deliberately neutral: on this sheet gold is reserved for
  money, so the surfaces underneath it stay the same white/graphite the form
  fields already use. One shape repeated is what makes the page read as a
  document rather than a stack of unrelated widgets.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/background_secondary" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
