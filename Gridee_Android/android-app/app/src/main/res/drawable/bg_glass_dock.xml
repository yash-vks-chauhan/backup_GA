<?xml version="1.0" encoding="utf-8"?>
<!-- iOS26-style glass panel for the lot picker's choice dock: translucent surface,
     hairline stroke, and a faint top highlight so it reads as glass, not paper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dock_glass_surface" />
            <corners android:radius="28dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/dock_glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.35"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
