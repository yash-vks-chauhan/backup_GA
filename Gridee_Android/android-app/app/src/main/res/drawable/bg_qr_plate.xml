<?xml version="1.0" encoding="utf-8"?>
<!--
  The QR plate. Deliberately pure white in BOTH themes: the code is drawn on a
  transparent canvas by BookingQrCodeGenerator, so the plate is what gives a
  scanner its quiet zone and its contrast. There is no -night variant on purpose.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="28dp" />
</shape>
