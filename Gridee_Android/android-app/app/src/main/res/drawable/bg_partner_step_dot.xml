<?xml version="1.0" encoding="utf-8"?>
<!--
  Numbered marker on the "when you get paid" timeline. A hollow ring rather than
  a filled dot: the rail behind it is a hairline, and a solid disc at every step
  turned the list into a row of bullets fighting the text for weight.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/background_secondary" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
