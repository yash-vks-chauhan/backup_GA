<?xml version="1.0" encoding="utf-8"?>
<!-- Shallow inset along the top edge so the unit reads as cut into the page rather than
     resting on it. Deliberately faint: this overlays an ad, and only a slight one is defensible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#40000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
